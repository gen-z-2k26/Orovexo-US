# WooCommerce REST API (required for products, categories, store identity, and orders)
WC_URL=https://your-wordpress-site.com
WC_CONSUMER_KEY=ck_xxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxx

# Public storefront origin for canonical URLs, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://your-storefront-domain.com

# CTX Feed XML URL from wp-admin (Feed URL on the CTX Feed screen)
CTX_FEED_URL=https://your-wordpress-site.com/wp-content/uploads/woo-feed/google/xml/your-feed.xml

# Stripe (headless checkout). Secret key stays on the Next.js server.
# Do not install the WooCommerce Stripe plugin for this storefront.
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
