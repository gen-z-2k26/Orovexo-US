WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Local only (yes/no). yes skips the Stripe charge only. Catalog, cart, and
# the Woo order (pending then set_paid) still go through WooCommerce.
# Ignored in production (Vercel). Do not set this on Vercel.
SKIP_STRIPE_PAYMENT=no

# Vercel (Production / Preview)
# Set the same Woo + Stripe vars in the Vercel project. Use test keys (sk_test_
# / pk_test_) until you are ready for live charges.
# NEXT_PUBLIC_SITE_URL=https://YOUR-PROJECT.vercel.app
# Stripe Dashboard (Test mode) → Developers → Webhooks → Add endpoint:
#   https://YOUR-PROJECT.vercel.app/api/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed,
# payment_intent.canceled
# Paste the endpoint signing secret as STRIPE_WEBHOOK_SECRET (whsec_...).
# Redeploy after changing env vars.
